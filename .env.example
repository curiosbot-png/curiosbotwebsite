# Copy to .env on the VPS (chmod 600). NEVER commit .env. Generate secrets with:  openssl rand -base64 36 | tr -d '=+/'

# ── Hostnames ───────────────────────────────────────────────
# Comma-separated public hosts. Staging first; add "curiosbot.com" at production cutover (docs/deployment.md).
PUBLIC_HOSTS=staging.curiosbot.com
ADMIN_HOST=admin.curiosbot.com
AUTOMATION_HOST=automation.curiosbot.com
NEXT_PUBLIC_SITE_URL=https://staging.curiosbot.com     # becomes https://curiosbot.com at cutover (canonical / sitemap / OpenGraph)
ACME_EMAIL=sales@curiosbot.com

# ── Database ────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=

# ── App secrets ─────────────────────────────────────────────
HASH_SALT=
N8N_WEBHOOK_SECRET=          # app → n8n Webhook Header Auth (bearer). Same value goes into the n8n credential "Curiosbot webhook (bearer)"
N8N_INGEST_SECRET=           # n8n → app /api/ingest + /api/internal/* (bearer). Same value in n8n credential "Curiosbot ingest (bearer)"
N8N_ENCRYPTION_KEY=          # encrypts n8n credentials at rest. BACK THIS UP separately; losing it makes stored credentials unreadable.

# ── n8n edge protection ─────────────────────────────────────
N8N_BASIC_AUTH_USER=curiosbot
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-long-password'   (paste the $2a$... hash; escape each $ as $$ in .env)
N8N_BASIC_AUTH_HASH=
N8N_VERSION=latest           # pin to a specific tag after the first successful deployment

# ── AI ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ── Misc ────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_CLIENT_NAMES=false   # set true only after confirming clients agree to be named
BACKUP_KEEP_DAYS=14
WEB_TAG=local
