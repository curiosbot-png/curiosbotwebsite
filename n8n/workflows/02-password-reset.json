{
  "name": "Curiosbot \u00b7 Admin password reset email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "password-reset",
        "authentication": "headerAuth",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Curiosbot webhook (bearer)"
        }
      },
      "webhookId": "password-reset"
    },
    {
      "parameters": {
        "fromEmail": "no-reply@curiosbot.com",
        "toEmail": "={{ $json.body.email }}",
        "subject": "Reset your Curiosbot admin password",
        "emailFormat": "text",
        "text": "={{ 'A password reset was requested for your Curiosbot admin account.\\nThis link is valid for 1 hour and can be used once:\\n' + $json.body.resetUrl + '\\n\\nIf you did not request this, ignore this email.' }}",
        "options": {}
      },
      "name": "Email reset link",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "Curiosbot SMTP"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Email reset link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "The reset URL contains a one-time token. Keep n8n execution data pruning on (EXECUTIONS_DATA_PRUNE) so tokens are not retained."
  },
  "tags": [
    {
      "name": "curiosbot"
    }
  ]
}
